<Window x:Class="MusicConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Converter" Height="850" Width="980"
        MinHeight="760" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Icon="Assets/MusicConverter.ico"
        Background="#F3F2EE">
    <Border Margin="12" Background="#FCFCFB" CornerRadius="18" BorderBrush="#E8E6E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.12" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="29" Height="29" CornerRadius="8" Background="#E6F5FC">
                        <Image Source="Assets/Music.png" Width="21" Height="21" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Music Converter" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="#353842" VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0" Padding="8,3" Background="#EAF8EF" CornerRadius="7">
                        <TextBlock Text="开源 · 免费" FontSize="10" Foreground="#27824C" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="—" FontSize="14" Background="Transparent" BorderThickness="0"
                        Foreground="#6A6E78" Cursor="Hand" Click="Minimize_Click" />
                <Button Grid.Column="2" Content="×" FontSize="20" Background="Transparent" BorderThickness="0"
                        Foreground="#6A6E78" Cursor="Hand" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="46,22,46,38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="0.82*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="178" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="把音乐带到任何播放器" FontSize="28" FontWeight="SemiBold" Foreground="#20232B" />
                        <TextBlock Text="开源免费，批量选择 MGG 文件并转换为高品质 MP3。" Margin="0,8,0,0"
                                   FontSize="14" Foreground="#767A84" />
                    </StackPanel>

                    <Border x:Name="DropZone" Grid.Row="2" CornerRadius="14" Background="#F7F6F3"
                            BorderBrush="#D9D7D0" BorderThickness="1" AllowDrop="True"
                            DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                            MouseLeftButtonDown="DropZone_MouseLeftButtonDown" Cursor="Hand">
                        <Grid Margin="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="15" Background="#ECE9FF">
                                    <TextBlock Text="＋" FontSize="26" Foreground="#6E5CE7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="FileTitleText" Text="选择一个或多个 .mgg 文件" Margin="0,14,0,0"
                                           FontSize="15" FontWeight="SemiBold" Foreground="#2D3039"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                                <TextBlock x:Name="FileHintText" Text="点击多选，或把多个文件拖到这里" Margin="0,6,0,0"
                                           FontSize="12" Foreground="#92959D" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="输出目录" FontSize="12" Foreground="#777B84" Margin="2,0,0,7" />
                            <TextBox x:Name="OutputFolderTextBox" Height="39" IsReadOnly="True" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="浏览" Style="{StaticResource GhostButton}"
                                Margin="0,24,0,0" Height="39" Click="BrowseOutput_Click" />
                    </Grid>

                    <Expander Grid.Row="6" Header="工具设置" Foreground="#555A65" FontFamily="{StaticResource AppFont}"
                              FontSize="13" Expanded="ToolsExpander_Expanded">
                        <Border Background="#F7F7F8" CornerRadius="10" Margin="0,9,0,0" Padding="13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="qmdec" VerticalAlignment="Center" Foreground="#696D76" />
                                <TextBox x:Name="QmdecPathTextBox" Grid.Column="1" Height="36" />
                                <Button Grid.Column="3" Content="选择" Style="{StaticResource GhostButton}" Padding="12,7"
                                        Click="BrowseQmdec_Click" />
                                <TextBlock Grid.Row="2" Text="FFmpeg" VerticalAlignment="Center" Foreground="#696D76" />
                                <TextBox x:Name="FfmpegPathTextBox" Grid.Row="2" Grid.Column="1" Height="36" />
                                <Button Grid.Row="2" Grid.Column="3" Content="选择" Style="{StaticResource GhostButton}" Padding="12,7"
                                        Click="BrowseFfmpeg_Click" />
                            </Grid>
                        </Border>
                    </Expander>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ConvertButton" Content="开始转换" Height="48" Style="{StaticResource PrimaryButton}"
                                Click="Convert_Click" IsEnabled="False" />
                        <Button x:Name="AuthButton" Grid.Column="2" Content="QQ 音乐授权" Height="48"
                                Style="{StaticResource GhostButton}" Click="Auth_Click" />
                    </Grid>

                    <Border Grid.Row="10" Background="#F3FBF6" CornerRadius="14"
                            BorderBrush="#DDEFE4" BorderThickness="1" Padding="17,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="124" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="好用的话，随手投喂一下？" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#2F4A39" />
                                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#607568"
                                           TextWrapping="Wrap" LineHeight="20"
                                           Text="如果刚好帮上了忙，欢迎随手投喂一两块——一分两分也很可爱。" />
                                <TextBlock Margin="0,7,0,0" Text="微信扫一扫 · 纯属随缘，不影响任何功能"
                                           FontSize="10.5" Foreground="#8A9A90" />
                            </StackPanel>
                            <Border Grid.Column="2" Width="124" Height="124" CornerRadius="9"
                                    BorderBrush="#DCE8E0" BorderThickness="1" ClipToBounds="True"
                                    ToolTip="微信扫一扫，随缘打赏">
                                <Border.Background>
                                    <ImageBrush ImageSource="收款码.jpg" Viewbox="310,400,700,700"
                                                ViewboxUnits="Absolute" Stretch="Fill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Background="#F7F7F8" CornerRadius="15" BorderBrush="#E9E9EB" BorderThickness="1">
                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="转换状态" FontSize="15" FontWeight="SemiBold" Foreground="#30333C" />
                            <Border Grid.Column="1" x:Name="StatusBadge" Background="#EDEEF1" CornerRadius="9" Padding="9,4">
                                <TextBlock x:Name="StatusBadgeText" Text="待机" FontSize="11" Foreground="#6D717B" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <ProgressBar x:Name="ConversionProgress" Height="7" Minimum="0" Maximum="100"
                                         Value="0" Foreground="#7B6CF6" Background="#E5E4E8" BorderThickness="0" />
                            <TextBlock x:Name="StatusText" Text="选择一个或多个文件后即可开始" Margin="0,10,0,0"
                                       FontSize="13" Foreground="#5E626D" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="处理流程" FontSize="11" Foreground="#9699A1" />
                                <TextBlock Text="MGG  →  OGG  →  MP3" Margin="0,7,0,0" FontSize="15"
                                           FontWeight="SemiBold" Foreground="#3A3D47" />
                                <TextBlock Text="MP3 · VBR 高品质 · 保留元数据" Margin="0,5,0,0"
                                           FontSize="11" Foreground="#8A8E97" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="运行日志" FontSize="11" Foreground="#9699A1" />
                            <TextBox x:Name="LogTextBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontFamily="Consolas"
                                     FontSize="11" Background="#FFFFFF" Foreground="#676B75" />
                        </Grid>

                        <Button x:Name="OpenOutputButton" Grid.Row="7" Content="打开输出目录" Margin="0,16,0,0"
                                Height="40" Style="{StaticResource GhostButton}" Click="OpenOutput_Click"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
